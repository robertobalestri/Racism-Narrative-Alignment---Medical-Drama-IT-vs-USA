# Azure OpenAI deployment used for every LLM call in this project.
# Copy this file to .env and fill in your own values.

GPT4_1_API_KEY = "your-azure-openai-key"
GPT4_1_ENDPOINT = "https://your-resource.openai.azure.com/"

AZURE_OPENAI_API_VERSION = "2024-10-21"
AZURE_OPENAI_LLM_DEPLOYMENT_NAME_GPT4_1 = "gpt-4.1"

# Temperature used for the published runs. Changing it changes the spread
# across the ten evaluations each episode receives.
AZURE_OPENAI_TEMPERATURE = "0.3"
